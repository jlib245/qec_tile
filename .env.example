# Copy to .env and fill in your allocation.  Real environment variables
# override these, so a one-off `QEC_TILE_WORKERS=4 python ...` still wins.
#
# This is a shared host: the CPU/GPU quota is administrative — there is no
# cgroup limit and no affinity mask, so os.cpu_count() cannot see it and the
# code deliberately has no defaults.  Everything below must be set.

# Sinter worker processes.
QEC_TILE_WORKERS=

# BLAS/OpenMP threads per process (OMP_NUM_THREADS and friends).  The total
# budget is WORKERS x THREADS, so leave this at 1 unless you also lower
# QEC_TILE_WORKERS.
QEC_TILE_THREADS=

# Physical GPU index this project may use.
QEC_TILE_GPU=
